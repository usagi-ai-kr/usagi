{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usagi-ai-kr/usagi/docs/e2e-result.schema.json",
  "title": "usagi E2E result",
  "description": "Harness-neutral result document for E2E and visual browser verification. See docs/e2e-contract.md for the operating contract and scripts/validate-e2e-result.mjs for the fail-closed validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target",
    "environment",
    "scenario",
    "budgets",
    "result",
    "artifacts",
    "evidence",
    "masking",
    "started_at",
    "duration_ms",
    "completeness"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Contract version of this document. Only 1 is defined."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-chosen identifier that ties the result, logs and artifacts of one run together."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit_sha"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Base URL actually served for this run."
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
          "description": "Commit SHA of the build under test: 40 (SHA-1) or 64 (SHA-256) hex characters."
        },
        "start_command": {
          "type": "string",
          "minLength": 1,
          "description": "Optional command used to start the target, so the process identity can be re-derived."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "browser",
        "browser_version",
        "viewport",
        "dpr",
        "locale",
        "timezone",
        "theme",
        "font_ready"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browser_version": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Device pixel ratio the page was rendered with."
        },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "font_ready": {
          "type": "boolean",
          "description": "True when required web fonts finished loading before capture; required true for a passed visual/mixed run."
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["behavior", "visual", "mixed"],
          "description": "behavior: assertions only. visual: screenshot evidence. mixed: both."
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "peak_rss_mb", "max_processes"],
      "properties": {
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "peak_rss_mb": { "type": "integer", "minimum": 0 },
        "max_processes": { "type": "integer", "minimum": 0 }
      },
      "description": "Resource budget targets for the run. Phase 1 validates wall_time_ms; peak_rss_mb and max_processes are recorded for later instrumentation."
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "assertions"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "blocked", "unavailable"],
          "description": "blocked: could not run (for example a port conflict). unavailable: the target or runner never produced a comparable state."
        },
        "exit_code": {
          "type": "integer",
          "description": "Runner process exit code. Must be 0 when status is passed and non-zero when status is failed."
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed", "blocked"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256", "size_bytes"],
        "properties": {
          "type": {
            "enum": ["screenshot", "trace", "video", "log", "json"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/).*$",
            "description": "Relative path of the artifact. Must not be absolute and must not contain '..' segments; the validator enforces both."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["console_errors", "network_failures"],
      "properties": {
        "stdout_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional reference to captured runner stdout."
        },
        "stderr_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional reference to captured runner stderr."
        },
        "console_errors": {
          "type": "integer",
          "minimum": 0,
          "description": "Browser console error count observed during the run."
        },
        "network_failures": {
          "type": "integer",
          "minimum": 0,
          "description": "Failed network request count observed during the run."
        }
      }
    },
    "masking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "fields"],
      "properties": {
        "applied": {
          "type": "boolean",
          "description": "True when masking of sensitive fields was applied to collected artifacts."
        },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Field names covered by masking."
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when the run started."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock duration of the run. Must not exceed budgets.wall_time_ms for a passed run."
    },
    "completeness": {
      "enum": ["complete", "partial", "unavailable"],
      "description": "Whether all planned steps and evidence were collected. Must be complete for a passed run."
    }
  }
}
